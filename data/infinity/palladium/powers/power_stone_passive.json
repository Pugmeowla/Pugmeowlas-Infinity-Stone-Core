        "execute as @e[tag=meteorite] at @s run particle minecraft:happy_villager ~ ~ ~ 0.1 0.1 0.1 0 6 force @a[distance=..50]",
        "execute as @e[tag=meteorite] at @s run particle minecraft:lava ~ ~ ~ 0.08 0.08 0.08 0 5 force @a[distance=..50]",

        "execute if score @s DamageCycle matches 0 run attribute @s minecraft:generic.attack_damage base set 1",
        "execute if score @s DamageCycle matches 1 run attribute @s minecraft:generic.attack_damage base set 2",
        "execute if score @s DamageCycle matches 2 run attribute @s minecraft:generic.attack_damage base set 4",
        "execute if score @s DamageCycle matches 3 run attribute @s minecraft:generic.attack_damage base set 8",
