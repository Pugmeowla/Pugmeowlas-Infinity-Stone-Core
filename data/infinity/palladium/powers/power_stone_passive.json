        "execute if score @s DamageCycle matches 10 run attribute @s minecraft:generic.attack_damage base set 1024",
        "execute if score @s DamageCycle matches 11 run attribute @s minecraft:generic.attack_damage base set 2048",

        "execute if score @s DamageCycle matches 12 run scoreboard players set @s DamageCycle 11",
        "execute if score @s DamageCycle matches -1 run scoreboard players set @s DamageCycle 0"
